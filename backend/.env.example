# ====================================================================
# MasterTools Domains - Environment Configuration
# ====================================================================

# Environment: 'development' | 'production'
# In production, Pydantic startup validation enforces:
# - DEBUG must be false
# - ADMIN_USERNAME cannot be 'admin'
# - SECRET_KEY and ADMIN_PASSWORD are required and cannot be known defaults
APP_ENV=development
DEBUG=true

# ====================================================================
# Security & Administrative Authentication
# ====================================================================
# In production, generate strong cryptographic secrets:
# python -c "import secrets; print('SECRET_KEY=' + secrets.token_hex(32)); print('ADMIN_PASSWORD=' + secrets.token_urlsafe(32))"
#
# SECRET_KEY: 256-bit hexadecimal string (min 32 chars)
# ADMIN_PASSWORD: Strong administrator password (min 12 chars)
# ADMIN_USERNAME: Unique administrator username (cannot be 'admin' in production)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=
SECRET_KEY=
ADMIN_SESSION_EXPIRE_HOURS=24

# Allowed CORS Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Maximum request payload size in bytes (default: 65536 = 64 KB)
MAX_REQUEST_BODY_BYTES=65536

# Public endpoint rate limits
RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_TRACK_PER_MINUTE=60

# ====================================================================
# Registrar Provider Switcher
# ====================================================================
# Active provider: 'mock' | 'godaddy' | 'namecheap' | 'porkbun'
# Default: 'mock' (Offline sandbox mode)
REGISTRAR_PROVIDER=mock
REGISTRAR_USE_SANDBOX=true

# ====================================================================
# GoDaddy API Configuration (REST)
# ====================================================================
# GODADDY_API_KEY=your_godaddy_api_key_here
# GODADDY_API_SECRET=your_godaddy_api_secret_here

# ====================================================================
# Namecheap API Configuration (XML)
# ====================================================================
# NAMECHEAP_API_USER=your_sandbox_username
# NAMECHEAP_API_KEY=your_sandbox_api_key
# NAMECHEAP_USERNAME=your_sandbox_username
# NAMECHEAP_CLIENT_IP=your_server_public_ip

# ====================================================================
# Porkbun API Configuration (Optional)
# ====================================================================
# PORKBUN_API_KEY=pk1_your_porkbun_api_key
# PORKBUN_SECRET_API_KEY=sk1_your_porkbun_secret_key

# ====================================================================
# Cloudflare API Configuration
# ====================================================================
# Token must have Zone:Read, DNS:Edit permissions
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
# CLOUDFLARE_DEFAULT_ZONE_ID=your_default_zone_id_here

# ====================================================================
# Vercel API Configuration
# ====================================================================
# VERCEL_API_TOKEN=your_vercel_api_token_here
# VERCEL_PROJECT_ID=prj_your_vercel_project_id_here
# VERCEL_TEAM_ID=team_your_team_id_here

# ====================================================================
# Render API Configuration
# ====================================================================
# RENDER_API_KEY=rnd_your_render_api_key_here
# RENDER_SERVICE_ID=srv_your_render_service_id_here
